generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Booking {
  id            String   @id @default(cuid())
  serviceSlug   String
  serviceName   String
  name          String
  email         String
  phone         String?
  preferredDate String?
  preferredTime String?
  notes         String?
  status        String   @default("pendente")
  createdAt     DateTime @default(now())
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  customerEmail   String?
  customerName    String?
  description     String
  amountTotal     Int
  currency        String
  mode            String
  status          String   @default("pago")
  createdAt       DateTime @default(now())
}

model SeatReservation {
  id              String    @id @default(cuid())
  classSlug       String
  classDate       DateTime
  name            String
  email           String
  phone           String?
  paymentType     String
  planSlug        String?
  stripeSessionId String?   @unique
  status          String    @default("pendente")
  createdAt       DateTime  @default(now())

  @@index([classSlug, classDate])
}

model ClassDefinition {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  description      String
  capacity         Int
  dropInPriceCents Int
  durationMinutes  Int            @default(60)
  active           Boolean        @default(true)
  recurring        Boolean        @default(true)
  endDate          DateTime?
  publicCalendar   Boolean        @default(true)
  roomId           String?
  teacherId        String?
  createdAt        DateTime       @default(now())
  slots            ClassSlotDef[]
  room             Room?          @relation(fields: [roomId], references: [id])
  teacher          Teacher?       @relation(fields: [teacherId], references: [id])
}

model ClassSlotDef {
  id           String          @id @default(cuid())
  classId      String
  weekday      Int?
  specificDate DateTime?
  time         String
  class        ClassDefinition @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Teacher {
  id        String               @id @default(cuid())
  name      String
  active    Boolean              @default(true)
  services  String[]             @default([])
  createdAt DateTime             @default(now())
  slots     TherapySlot[]
  windows   AvailabilityWindow[]
  classes   ClassDefinition[]
}

model Room {
  id        String               @id @default(cuid())
  name      String
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  slots     TherapySlot[]
  windows   AvailabilityWindow[]
  classes   ClassDefinition[]
}

model AvailabilityWindow {
  id        String   @id @default(cuid())
  teacherId String
  roomId    String
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([teacherId, weekday])
}

model TherapySettings {
  id           String  @id @default("singleton")
  breakMinutes Int     @default(15)
  lunchStart   String?
  lunchEnd     String?
}

model TherapySlot {
  id              String   @id @default(cuid())
  teacherId       String
  roomId          String
  serviceSlug     String
  date            DateTime
  durationMinutes Int      @default(60)
  status          String   @default("disponivel")
  clientName      String?
  clientEmail     String?
  clientPhone     String?
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([serviceSlug, date])
  @@index([teacherId, date])
  @@index([roomId, date])
}
